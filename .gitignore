# JJE runtime state + local project config (per-repo, never committed)
.jje/runs/
.jje/worktrees/
.jje/COMMIT_APPROVED
.jje/ACTIVE
.jje/config.json
.jje/conventions/

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp

# Plugin build artifact — dist/plugin IS committed (it is the marketplace source)
dist/*
!dist/plugin/

# Terraform working artifacts (from juror/eval runs)
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
tfplan.binary
tfplan.json
